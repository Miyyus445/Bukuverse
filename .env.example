# Environment Variables Example
# Copy this file to .env and fill in the values

# Database (Neon)
# Pooled connection for queries
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bukuverse?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bukuverse"

# Google Books API (optional - for higher rate limits)
# GOOGLE_BOOKS_API_KEY="your-api-key-here"

# Frontend (Next.js)
# NEXT_PUBLIC_API_URL="http://localhost:3001"

# Backend (NestJS)
# PORT=3001
# NODE_ENV=development